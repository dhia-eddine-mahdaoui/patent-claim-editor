{
  "name": "patent-claim-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview --port 4174 --strictPort",
    "media:screenshots": "npm run build && tsx scripts/media.ts screenshots",
    "demo": "npm run build && tsx scripts/media.ts demo && bash scripts/encode-gif.sh"
  },
  "dependencies": {
    "@fastify/static": "7.0.4",
    "@fontsource-variable/inter": "5.1.0",
    "@fontsource-variable/source-serif-4": "5.1.0",
    "@tiptap/core": "2.10.4",
    "@tiptap/extension-document": "2.10.4",
    "@tiptap/extension-paragraph": "2.10.4",
    "@tiptap/extension-text": "2.10.4",
    "@tiptap/pm": "2.10.4",
    "@tiptap/react": "2.10.4",
    "fastify": "4.28.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.1",
    "@playwright/test": "1.52.0",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.4.8",
    "@testing-library/react": "16.0.0",
    "@types/node": "18.19.67",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "jsdom": "24.1.1",
    "playwright-core": "1.52.0",
    "tsx": "4.19.2",
    "typescript": "5.5.4",
    "vite": "5.4.2",
    "vitest": "2.0.5"
  }
}
